<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="StolenGalaxy" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <!-- Entity classes -->
        <class>com.stolengalaxy.User</class>
        <class>com.stolengalaxy.Project</class>
        <class>com.stolengalaxy.Task</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Connection -->
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:app.db"/>
            <property name="eclipselink.target-database" value="com.stolengalaxy.db.SQLitePlatform"/>

            <!-- Create the schema if it doesn't exist -->
            <property name="eclipselink.ddl-generation" value="create-tables"/>
            <property name="eclipselink.ddl-generation.output-mode" value="database"/>

            <!-- Logging -->
            <property name="eclipselink.logging.level" value="WARNING"/>
            <property name="eclipselink.logging.file" value="output.log"/>
        </properties>
    </persistence-unit>
</persistence>
